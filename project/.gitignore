# Godot 4+ specific ignores
!.godot/.gdignore
.godot/

# Generated
!node_modules/.gdignore
node_modules/
# extension_api.json is SOURCE DATA for the static-binding codegen
# (not a build artifact) -- keep it versioned so CI can build without
# a godot editor binary.
!extension_api.json
gen/
typings/

# Built library output installed by SCons (godotjs-ext.windows.*.dll etc.)
addons/godotjs-ext.daylily-zeleen/bin/