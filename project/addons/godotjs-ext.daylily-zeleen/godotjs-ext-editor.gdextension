[configuration]

entry_symbol = "jsb_editor_library_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

windows.debug.editor.x86_64 = "bin/windows/godotjs-ext-editor.windows.editor.x86_64.dll"
windows.debug.editor.arm64 = "bin/windows/godotjs-ext-editor.windows.editor.arm64.dll"

macos.debug.editor = "bin/macos/godotjs-ext-editor.macos.editor.universal.dylib"
# Per-arch key for the arm64-only builds (v8 / node / jsc legs). Godot resolves
# the arch-specific key first and only then falls back to the arch-less one, so
# without this an arm64 artifact is looked up as "...universal.dylib" - a file
# that arch's build never produces - and the editor extension fails to load
# (taking --godotjs-api-generate with it).
macos.debug.editor.arm64 = "bin/macos/godotjs-ext-editor.macos.editor.arm64.dylib"

linux.debug.editor.x86_64 = "bin/linux/godotjs-ext-editor.linux.editor.x86_64.so"
linux.debug.editor.arm64 = "bin/linux/godotjs-ext-editor.linux.editor.arm64.so"
